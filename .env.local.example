# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-public-key-aqui
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Chave Pix que vai receber o sinal, e os dados exatamente como você quer que
# apareçam no pagamento (nome até 25 caracteres, cidade até 15).
PIX_KEY=chave-pix-do-estudio
PIX_RECEIVER_NAME=NOME DO RECEBEDOR
PIX_RECEIVER_CITY=CIDADE
