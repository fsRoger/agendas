# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-public-key-aqui
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Cada local tem sua própria chave Pix (pessoas diferentes recebendo o
# sinal). Nome até 25 caracteres, cidade até 15 — acentos são removidos
# automaticamente na hora de gerar o QR, pode deixar como está.
PIX_KEY_CILIOS=chave-pix-do-vallue-studio
PIX_RECEIVER_NAME_CILIOS=NOME DO RECEBEDOR
PIX_RECEIVER_CITY_CILIOS=CIDADE

PIX_KEY_UNHAS=chave-pix-do-thany-studio
PIX_RECEIVER_NAME_UNHAS=NOME DO RECEBEDOR
PIX_RECEIVER_CITY_UNHAS=BARUERI
